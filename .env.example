# TMDB API read access token (v4 bearer token). Get one at https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# The absolute origin this deployment answers on — scheme and host, no trailing slash, e.g.
# https://example.com. Canonical URLs, Open Graph URLs, sitemap.xml and the robots.txt Host are all
# built from it, so an unset value points every one of them at http://localhost:3000, which nothing
# outside the machine can reach. Set it for any deployment that is not on Vercel (there the
# project's production URL fills in on its own).
#
# NEXT_PUBLIC_* is read at build time, so it has to be present for `npm run build` / `docker build`
# — setting it only on the running container is too late.
NEXT_PUBLIC_SITE_URL=

# Optional: the link-preview image (Open Graph / Twitter card) for pages that have no artwork of
# their own. Defaults to the bundled /og.png; point it at a URL you host to change the artwork
# without a redeploy.
NEXT_PUBLIC_OG_IMAGE=

# Optional: shared secret to protect /api/revalidate (used by a scheduled cron to
# refresh the TMDB cache in the background). If unset, the endpoint is open.
REVALIDATE_SECRET=
