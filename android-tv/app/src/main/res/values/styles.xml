<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No action bar — Compose owns the whole screen. The window background
         matches the app background so there's no flash on cold start. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
    </style>

    <!-- Playback is always on black, edge to edge. -->
    <style name="PlayerTheme" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
